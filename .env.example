# =============================================================================
# IntentUI — Environment Variables
# Copy to .env and fill in values. Never commit .env to git.
# =============================================================================

# --- Gemini (primary LLM) ---
# Get your API key: https://aistudio.google.com/apikey
# Used for: semantic extraction + explanation generation
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Groq (fallback LLM) ---
# Get your API key: https://console.groq.com/keys
# Used when Gemini times out, rate-limits, or is unavailable
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Backend ---
LOG_LEVEL=INFO
# Frontend dev server proxies WebSocket to this URL
BACKEND_WS_URL=ws://localhost:8000/ws

# --- Frontend (Vite — prefix with VITE_) ---
VITE_WS_URL=ws://localhost:8000/ws
# Set to "mock" to run without backend (uses local mock engine)
VITE_ENGINE_MODE=live
